# Copia este archivo a `.env.local` para desarrollo local.
# En Vercel, la integración de Supabase crea estas variables automáticamente
# (o agrégalas en Project Settings → Environment Variables).

# URL del proyecto de Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Llave pública (publishable, sb_publishable_…). También acepta NEXT_PUBLIC_SUPABASE_ANON_KEY.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Llave secreta (secret, sb_secret_…). SÓLO servidor: nunca con prefijo NEXT_PUBLIC_.
# También acepta SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Avisos por correo de cada mensaje de contacto (Resend). Sin RESEND_API_KEY no se envía nada.
RESEND_API_KEY=
# Opcional: destinatarios (separados por coma). Por defecto, el correo de contacto del sitio.
CONTACT_NOTIFY_TO=
# Opcional: remitente; debe ser de un dominio verificado en Resend.
CONTACT_FROM_EMAIL="Grupo STF <notificaciones@grupostf.hn>"

# Secreto para POST /api/revalidate (refrescar vacantes al instante). Genera uno con:
#   openssl rand -hex 32
REVALIDATE_SECRET=

# URL pública del sitio (canonical, sitemap, Open Graph). En Vercel se toma del dominio de producción.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
